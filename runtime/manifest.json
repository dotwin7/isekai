{
  "id": "isekai-project-runtime",
  "kind": "project-local-runtime",
  "version": "0.1.0",
  "description": "Version-pinned project-local ISEKAI AI-DLC runtime for existing agent hosts",
  "core": {
    "package": "isekai-ai-dlc-runtime",
    "interface": "isekai runtime",
    "user_interface": "isekai <action>",
    "protocol_version": "1.0.0"
  },
  "compatibility": {
    "matrix": "compatibility.json",
    "policy": "verified-baseline"
  },
  "trust_model": {
    "core_enforcement": "record-consistency-and-tamper-detection",
    "action_execution": "runtime-host-outside-core",
    "human_identity": "caller-attested-not-core-verified",
    "evidence_execution": "runtime-attested-not-core-executed",
    "external_controls_required": [
      "runtime sandbox and permission policy",
      "authenticated human confirmation channel",
      "CI or host execution provenance"
    ]
  },
  "adapters": [
    {
      "id": "kiro",
      "surface": "workspace-agent-skill",
      "path": "runtime/adapters/kiro/skills/isekai/SKILL.md"
    },
    {
      "id": "claude",
      "surface": "project-skill",
      "path": "runtime/adapters/claude/skills/isekai/SKILL.md"
    },
    {
      "id": "codex",
      "surface": "repo-skill",
      "path": "runtime/adapters/codex/skills/isekai/SKILL.md"
    }
  ],
  "actions": [
    "init",
    "handshake",
    "on",
    "off",
    "status",
    "intake",
    "route",
    "inception",
    "compatibility",
    "release-check",
    "foundation-decision",
    "foundation-evidence",
    "foundation-promote",
    "project-knowledge-status",
    "project-knowledge-propose",
    "project-knowledge-promote",
    "resume",
    "unit-migrate",
    "unit-init",
    "checkpoint",
    "envelope-propose",
    "envelope-approve",
    "authorize",
    "evidence",
    "decision",
    "transition",
    "verify"
  ],
  "writes": [
    "init",
    "unit-init",
    "unit-migrate",
    "checkpoint",
    "envelope-propose",
    "envelope-approve",
    "authorize",
    "evidence",
    "decision",
    "transition",
    "foundation-decision",
    "foundation-evidence",
    "foundation-promote",
    "project-knowledge-propose",
    "project-knowledge-promote"
  ],
  "high_risk_actions": [],
  "human_decision_actions": [
    "decision",
    "foundation-decision",
    "foundation-promote"
  ],
  "dependencies": []
}
