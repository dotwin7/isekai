{
  "id": "isekai-project-runtime",
  "kind": "project-local-runtime",
  "version": "0.2.1",
  "description": "Version-pinned project-local ISEKAI AI-DLC runtime for existing agent hosts",
  "core": {
    "package": "isekai-ai-dlc-runtime",
    "interface": "isekai runtime",
    "user_interface": "isekai <action>",
    "protocol_version": "1.1.0"
  },
  "compatibility": {
    "matrix": "compatibility.json",
    "policy": "verified-baseline"
  },
  "trust_model": {
    "core_enforcement": "record-consistency-tamper-detection-active-unit-binding-and-managed-execution",
    "action_execution": "core-managed-edit-and-test",
    "conversation_change_reporting": "runtime-adapter-attested-not-core-observed",
    "human_identity": "caller-attested-not-core-verified",
    "evidence_execution": "core-receipted-for-managed-tests",
    "secret_resolution": "runtime-host-outside-core",
    "external_controls_required": [
      "host direct-write tools disabled in favor of the Core gateway",
      "active-Unit user-turn routing by the Runtime Adapter",
      "authenticated human confirmation channel",
      "CI or host execution provenance",
      "host secret broker and output redaction"
    ]
  },
  "feature_model": {
    "unit": "versioned-isekai-feature",
    "distribution": "core-bundled-or-feature-package",
    "exposure": "project-local-core-mcp-control-plane",
    "context_binding": "sha256-feature-catalog-and-package-digests",
    "project_ownership": "not-a-product-extension",
    "permission_effect": "cannot-expand-foundation-project-or-unit-authority"
  },
  "adapters": [
    {
      "id": "kiro",
      "surface": "workspace-agent-skill",
      "path": "runtime/adapters/kiro/skills/isekai/SKILL.md"
    },
    {
      "id": "claude",
      "surface": "project-skill",
      "path": "runtime/adapters/claude/skills/isekai/SKILL.md"
    },
    {
      "id": "codex",
      "surface": "repo-skill",
      "path": "runtime/adapters/codex/skills/isekai/SKILL.md"
    }
  ],
  "actions": [
    "init",
    "handshake",
    "on",
    "off",
    "status",
    "intake",
    "route",
    "inception",
    "compatibility",
    "feature-status",
    "release-check",
    "foundation-decision",
    "foundation-evidence",
    "foundation-promote",
    "project-knowledge-status",
    "project-knowledge-propose",
    "project-knowledge-promote",
    "resume",
    "unit-migrate",
    "unit-init",
    "checkpoint",
    "amend",
    "active-unit-detach",
    "envelope-propose",
    "envelope-approve",
    "authorize",
    "managed-edit",
    "managed-test",
    "artifact-write",
    "evidence",
    "decision",
    "transition",
    "verify"
  ],
  "writes": [
    "init",
    "unit-init",
    "unit-migrate",
    "checkpoint",
    "amend",
    "active-unit-detach",
    "envelope-propose",
    "envelope-approve",
    "authorize",
    "managed-edit",
    "managed-test",
    "artifact-write",
    "evidence",
    "decision",
    "transition",
    "foundation-decision",
    "foundation-evidence",
    "foundation-promote",
    "project-knowledge-propose",
    "project-knowledge-promote"
  ],
  "high_risk_actions": [],
  "external_agent_actions": [
    "external-api"
  ],
  "credential_handling": "opaque-reference-resolved-by-host",
  "human_decision_actions": [
    "amend",
    "active-unit-detach",
    "decision",
    "foundation-decision",
    "foundation-promote"
  ],
  "dependencies": []
}
